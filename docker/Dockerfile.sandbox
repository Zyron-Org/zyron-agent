FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV SHELL=/bin/bash

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    ca-certificates \
    jq \
    python3 \
    python3-pip \
    python3-venv \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 22 LTS
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user 'zyron' (Ubuntu 24.04 includes a default 'ubuntu' user with UID 1000)
RUN userdel -r ubuntu 2>/dev/null || true \
    && useradd -m -s /bin/bash -u 1000 zyron \
    && mkdir -p /workspace \
    && chown -R zyron:zyron /workspace

USER zyron
WORKDIR /home/zyron

# Install Foundry
ENV PATH="/home/zyron/.foundry/bin:${PATH}"
RUN curl -L https://foundry.paradigm.xyz | bash \
    && /home/zyron/.foundry/bin/foundryup

# Install solc-select and pre-fetch common compiler versions
ENV PATH="/home/zyron/.local/bin:${PATH}"
RUN pip3 install --break-system-packages --user solc-select \
    && /home/zyron/.local/bin/solc-select install 0.8.20 \
    && /home/zyron/.local/bin/solc-select install 0.8.24 \
    && /home/zyron/.local/bin/solc-select install 0.8.28 \
    && /home/zyron/.local/bin/solc-select use 0.8.28

WORKDIR /workspace
CMD ["tail", "-f", "/dev/null"]
