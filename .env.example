# ==============================================================================
# ZYRON AGENT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=production

# Google Gemini AI LLM Configuration
# Recommended models: gemini-3.5-flash-lite, gemini-3.5-flash
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.5-flash-lite"

# Web3 Read-Only Fork RPC Endpoints (Used by sandbox for mainnet/L2 state forks)
RPC_MAINNET="https://cloudflare-eth.com"
RPC_ARBITRUM="https://arb1.arbitrum.io/rpc"
RPC_SEPOLIA="https://sepolia-rollup.arbitrum.io/rpc"

# Internal Authentication & Security
# Shared API key with zyron-backend for authenticated requests (Header: x-zyron-agent-key)
AGENT_API_KEY="your-agent-internal-secret-api-key"

# HMAC Shared Secret used to sign webhook callback payloads delivered to zyron-backend
CALLBACK_SHARED_SECRET="your-callback-hmac-shared-secret"

# Zyron Backend API Base URL for callback delivery and repository credential lookups
BACKEND_URL="http://localhost:4000"

# Optional: Agent cryptographic key for signing proven findings
AGENT_PRIVATE_KEY=""
