# ==============================================================================
# ZYRON AGENT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=production

# Google Gemini AI LLM Configuration
# Recommended models: gemini-3.5-flash-lite, gemini-3.5-flash
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.5-flash-lite"

# Prover LLM selection: "meta" | "gemini". If unset: meta when MODEL_API_KEY is set, else gemini.
LLM_PROVIDER="meta"

# Meta Model API (OpenAI-compatible). Server-side only - never expose to the frontend.
MODEL_API_KEY=""
META_MODEL="muse-spark-1.3"
META_API_BASE_URL="https://api.meta.ai/v1"
META_TIMEOUT_MS=90000
META_MAX_RETRIES=3
# Optional; leave unset unless confirmed supported by the model (reasoning models may reject them):
# META_TEMPERATURE=
# META_MAX_COMPLETION_TOKENS=

# Sandbox isolation. Default "docker" fails closed if Docker/image is unavailable.
# "host" runs generated code on this machine and additionally requires ALLOW_UNSAFE_HOST_EXECUTION=true
# (refused when NODE_ENV=production). Use only for local development.
SANDBOX_MODE="docker"
ALLOW_UNSAFE_HOST_EXECUTION="false"
SANDBOX_IMAGE="zyron-sandbox:latest"

# Prover budgets
PROVER_MAX_TURNS=20
PROVER_MAX_DURATION_MS=900000

# Web3 Read-Only Fork RPC Endpoints (Used by sandbox for Monad/L2 state forks)
RPC_MONAD_TESTNET="https://testnet-rpc.monad.xyz"
RPC_MAINNET="https://cloudflare-eth.com"
RPC_ARBITRUM="https://arb1.arbitrum.io/rpc"
RPC_SEPOLIA="https://sepolia-rollup.arbitrum.io/rpc"

# Internal Authentication & Security
# Shared API key with zyron-backend for authenticated requests (Header: x-zyron-agent-key)
AGENT_API_KEY="your-agent-internal-secret-api-key"

# HMAC Shared Secret used to sign webhook callback payloads delivered to zyron-backend
CALLBACK_SHARED_SECRET="your-callback-hmac-shared-secret"

# Zyron Backend API Base URL for callback delivery and repository credential lookups
BACKEND_URL="http://localhost:4000"

# Optional: Agent cryptographic key for signing proven findings
AGENT_PRIVATE_KEY=""
